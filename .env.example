APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis and run `php artisan horizon` (Linux/WSL/server).
# Horizon dashboard: /horizon (requires login; local = any user, production = HORIZON_ALLOWED emails in HorizonServiceProvider).
# Windows (Laragon): Horizon cannot run (needs pcntl). Use: composer run queue:dev
DB_QUEUE_RETRY_AFTER=120

HORIZON_PATH=horizon
# HORIZON_PREFIX=

ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
# Command Center WhatsApp (platform number + inbound webhook for the same AI employee as web chat)
ZERNIO_WHATSAPP_NUMBER=
ZERNIO_WHATSAPP_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MINDCASE_API_KEY=

# Optional — fetches pages through ScraperAPI when Cloudflare blocks audit / pull brand (uses JS render by default)
SCRAPER_API_KEY=
# AUDIT_SCRAPER_RENDER=true
# AUDIT_SCRAPER_TIMEOUT=90

# Anthropic — site planning, AI edits, follow-up sequence drafts, locale translation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheaper model for site editor chat (routing, scoped CSS). Sonnet stays on initial site builds.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
SITE_EDIT_USE_EXECUTOR=true
AI_DEFAULT_PROVIDER=anthropic

# Site hero / editor photos — openai | openrouter | auto (prefers OpenAI when OPENAI_API_KEY is set)
SITE_IMAGE_DRIVER=auto

# OpenAI direct (when SITE_IMAGE_DRIVER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Command Center AI employee (OpenAI — not Anthropic)
COMMAND_CENTER_EMPLOYEE_NAME=Mira
# COMMAND_CENTER_EMPLOYEE_AVATAR_URL=
COMMAND_CENTER_OPENAI_MODEL="${OPENAI_MODEL}"

# OpenRouter image generation (when SITE_IMAGE_DRIVER=openrouter or auto with this key set)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER="${APP_URL}"
# OPENROUTER_APP_TITLE="${APP_NAME}"

# Comma-separated emails of platform administrators (opens the Admin area)
ADMIN_EMAILS=
